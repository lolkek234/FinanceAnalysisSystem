<Window x:Class="FinanceAnalysisSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система анализа финансовых результатов" Height="600" Width="900"
        Background="#F5F5F5">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Система анализа финансовых результатов" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Background="#E8F5E9" CornerRadius="5" Padding="10" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Доход" FontSize="12" Foreground="#666"/>
                        <TextBlock Text="0" FontSize="20" FontWeight="Bold" Foreground="#4CAF50"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="1" Background="#FFEBEE" CornerRadius="5" Padding="10" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Расходы" FontSize="12" Foreground="#666"/>
                        <TextBlock Text="0" FontSize="20" FontWeight="Bold" Foreground="#F44336"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="2" Background="#E3F2FD" CornerRadius="5" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Прибыль" FontSize="12" Foreground="#666"/>
                        <TextBlock Text="0" FontSize="20" FontWeight="Bold" Foreground="#2196F3"/>
                    </StackPanel>
                </Border>
            </Grid>
            
            <DataGrid Margin="0,20,0,20" Height="300" AutoGenerateColumns="True"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="+ Добавить операцию" Padding="15,10" Margin="0,0,10,0" Background="#4CAF50" Foreground="White"/>
                <Button Content="📊 Просмотреть отчет" Padding="15,10" Margin="0,0,10,0" Background="#2196F3" Foreground="White"/>
                <Button Content="💾 Сохранить" Padding="15,10" Background="#FF9800" Foreground="White"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
