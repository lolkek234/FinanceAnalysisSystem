<Window x:Class="FinanceAnalysisSystem.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Финансовый отчет" Height="600" Width="700"
        Background="#F5F5F5" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20">
            <TextBlock Text="Финансовый отчет" FontSize="20" Foreground="White" FontWeight="Bold"/>
        </Border>

        <!-- Report Summary -->
        <Border Grid.Row="1" Background="White" Margin="10" Padding="20">
            <StackPanel>
                <!-- Key Metrics -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Доход" Foreground="#7F8C8D" FontSize="11"/>
                        <TextBlock Text="{Binding TotalIncome, StringFormat=C}" FontSize="16" FontWeight="Bold" Foreground="#27AE60"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Расходы" Foreground="#7F8C8D" FontSize="11"/>
                        <TextBlock Text="{Binding TotalExpenses, StringFormat=C}" FontSize="16" FontWeight="Bold" Foreground="#E74C3C"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Прибыль" Foreground="#7F8C8D" FontSize="11"/>
                        <TextBlock Text="{Binding NetProfit, StringFormat=C}" FontSize="16" FontWeight="Bold" Foreground="#3498DB"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Рентабельность" Foreground="#7F8C8D" FontSize="11"/>
                        <TextBlock Text="{Binding ReturnOnRevenue, StringFormat=F2}%" FontSize="16" FontWeight="Bold" Foreground="#F39C12"/>
                    </StackPanel>
                </Grid>

                <!-- Report Text -->
                <TextBlock Text="Подробный отчет:" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBox Text="{Binding ReportText}" IsReadOnly="True" Height="400" Padding="10" 
                         Foreground="#2C3E50" Background="#ECF0F1" FontFamily="Courier New" FontSize="11" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Border>

        <!-- Close Button -->
        <Border Grid.Row="2" Background="#ECF0F1" Padding="20">
            <Button Content="Закрыть" Click="CloseButton_Click" Background="#95A5A6" Foreground="White" 
                    Padding="20,8" FontWeight="Bold" HorizontalAlignment="Right" Width="120"/>
        </Border>
    </Grid>
</Window>